# Postgres connection for the app and Alembic; matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://maitre_d:maitre_d@localhost:5432/maitre_d
# Separate database the test suite creates tables in; never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://maitre_d:maitre_d@localhost:5432/maitre_d_test
# Bearer token ElevenLabs sends to the tool endpoints. Must be a long random value, not a
# placeholder someone might reuse; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving it empty makes every tool endpoint return 500 (fail closed), never 200.
TOOL_BEARER_SECRET=
# ElevenLabs API key, from the ElevenLabs dashboard (Developers > API Keys).
ELEVENLABS_API_KEY=
# HMAC secret for the post-call webhook, shown once when the webhook is created in ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
# ID of the agent, printed by `elevenlabs agents push` or shown in the agent's dashboard URL.
ELEVENLABS_AGENT_ID=
# Python log level: DEBUG logs caller-provided data, so use INFO outside local debugging.
LOG_LEVEL=INFO
