    "/api/metrics/tool-latency": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Tool Latency",
        "description": "Server-side p50 and p95 per tool, from requests that succeeded.\n\nOnly 200s count. A 401 is rejected before the handler runs, and a 500 can be recorded as 0 ms\nbecause the app raised before it timed anything; either would pull the percentiles down and\nmake a broken tool look fast.",
        "operationId": "tool_latency_api_metrics_tool_latency_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ToolLatencyRow"
                  },
                  "type": "array",
                  "title": "Response Tool Latency Api Metrics Tool Latency Get"
                }
              }
            }
          }
        }
      }
    }
